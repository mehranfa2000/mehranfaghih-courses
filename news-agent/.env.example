# اینتلی‌نیوز - متغیرهای محیطی (اختیاری)

# پورت سرور
PORT=8000

# حالت دمو - اگر فعال باشد، در صورت قطعی اینترنت داده نمونه تولید می‌کند
# DEMO_MODE=1

# توکن تلگرام (اختیاری - می‌توان از داشبورد هم تنظیم کرد)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=@your_channel

# بازه پیش‌فرض به دقیقه
DEFAULT_INTERVAL=60
